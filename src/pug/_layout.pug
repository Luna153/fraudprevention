include _component.pug
//- include _data.pug

doctype html
html(lang="zh-Hant")
  block vars
    - var author = '永豐銀行'
    - var web_title = '永豐銀行【警覺詐騙 保護自己】'
    - var web_url = 'https://bank.sinopac.com/sinopacBT/webevents/fraudprevention'
    - var og_url = 'https://bank.sinopac.com/sinopacBT/webevents/fraudprevention/'
    - var og_title = '永豐銀行【警覺詐騙 保護自己】'
    - var og_image = 'https://bank.sinopac.com/sinopacBT/webevents/fraudprevention/images/share.jpg'
    - var og_desc = '永豐銀行防詐騙專區，遇到詐騙，務必斷！捨！釐！快豐鎖！永豐4防線，與客戶一同打詐、守護權益。'
    - var schema_classify = '永豐銀行【警覺詐騙 保護自己】'
    - var date_publish = ''
    - var keywords = ''
    //- root位置勿更動也勿使用
    - var root = '../../'
    - var pageName = ''

  head
    block head
      meta(charset='UTF-8')
      meta(name='viewport' content='width=device-width, initial-scale=1.0, user-scalable=no, viewport-fit=cover')
      meta(name='format-detection' content='telephone=no')
      meta(http-equiv='X-UA-Compatible' content='IE=edge,Chrome=1')
      //- 不緩存
      meta(http-equiv='pragma' content='no-cache')
      meta(http-equiv='Cache-Control' content='no-cache, no-store, must-revalidate')
      meta(http-equiv='expires' content='0')
      //- meta info
      title #{schema_classify ? schema_classify : "" }
      meta(name='title' content=(schema_classify ? schema_classify : '' ))
      meta(name='description', content=og_desc ? og_desc : '')
      meta(name='og:description', content=og_desc ? og_desc : '')
      meta(property='og:title', content=(og_title ? og_title : ''))
      meta(property='og:url', content=og_url ? og_url : '')
      meta(property='og:image', content=og_image ? og_image : '')
      meta(property='og:type' content='website')
      meta(property='og:locale' content='zh_TW')
      meta(name='keywords' content=keywords)
      meta(name='author', content=author)
      meta(name='copyright', content=author)
      //- 標準網址
      link(rel='canonical' href=web_url)
      //- favicon
      link(rel='shortcut icon' href='https://mma.sinopac.com/images/favicon.ico')
      //- css
      link(rel='stylesheet' href='css/splide.min.css')
      link(rel='stylesheet' href='css/aos.css')
      link(rel='stylesheet' href='css/loading.css')
      link(rel='preconnect' href='https://fonts.googleapis.com')
      link(rel='preconnect' href='https://fonts.gstatic.com' crossorigin='')
      link(href='https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@100..900&display=swap' rel='stylesheet')

      //- shippori Mincho
      link(href='https://fonts.googleapis.com/css2?family=Shippori+Mincho&display=swap' rel='stylesheet')
      link(rel='stylesheet' href='./css/all.css?v=240522')
      script(src="js/jquery-latest.min.securejs" type="text/javascript")
      script(src="js/splide.min.securejs" type="text/javascript")
      script(src="js/aos.securejs" type="text/javascript")
      //- 數位足跡
      //- Solene:此處會報錯，先忽略，上永豐環境需使用
      script(type='text/javascript' src='../../bspjs/UrlSetting.js')
      script(type='text/javascript' src='../../bspjs/sensorstracker.js')
      //- script(src= root +'js/sensorstrackerV105.js' type="text/javascript")
      script(src="js/gsap.min.securejs" type="text/javascript")
      script(src="js/TextPlugin.min.securejs" type="text/javascript")

  body
    //- img(src="./materials/phase2/預防詐騙專區-202405_web.jpg" alt="" style="position: absolute; top: 0; left: 50%; transform: translateX(-50%); width:1920px; opacity: 0.5; z-index: 9999; pointer-events: none;")
    //- img(src="./materials/phase2/預防詐騙專區-202405_mob.jpg" alt="" style="position: absolute; top: 0; left: 50%; transform: translateX(-50%); width:768px; opacity: 0.5; z-index: 9999; pointer-events: none;")

    //- block loading
    include _loading.pug
    .wrap
      block header
        include layout/_header.pug
      .content
        block content

      block footer
        include layout/_footer.pug

    block script
      //- script(src="js/ScrollTrigger.min.securejs" type="text/javascript")
      script.
        document.addEventListener("DOMContentLoaded", function() {
        let today = new Date();
        let dateString = today.toISOString().substring(0, 10).replace(/-/g, '');
        let script = document.createElement('script');
        script.src = './js/index.securejs?v=' + dateString;
        document.head.appendChild(script);
        });

      script.
        //- loading
        $(window).on("load", function () {
          $.Window = $(window);
          $.Body = $('body');

          $('body').css('visibility', 'visible');
          $(".loader").delay(500).fadeOut("slow");
          $("#overlayer").delay(500).fadeOut("slow");
          $('.fixedIcon__area').hide();
        })

        $(window).scroll(function () {
          if ($(this).scrollTop() > 100) {
            $('.fixedIcon__area').fadeIn(200);
          } else {
            $('.fixedIcon__area').fadeOut(200);
          }
        });

