//- section
mixin section-intro()
  section.section.section-intro#section-intro
    .wrap__inner
      //-輪播卡片
      .section-intro__card(data-aos="fade-up")
        .splide.slider-intro
          .splide__track
            ul.splide__list
              li.splide__slide(data-aos="fade-up" data-aos-duration="900")
                img(src="images/icon_intro-1.svg" alt="")
                h3.card-title.noto-900
                  .em.fc-pink-1 身分冒用
                  .sub.fc-gray-1 最常見
                p.card-desc.noto-500.fc-gray-1
                  |臺灣「帳單繳款詐騙」
                  br
                  |高於亞洲各國
              li.splide__slide(data-aos="fade-up" data-aos-duration="1200")
                img(src="images/icon_intro-2.svg" alt="")
                h3.card-title.noto-900
                  .em.fc-pink-1 6成
                  .sub.fc-gray-1 用簡訊詐騙
                p.card-desc.noto-500.fc-gray-1
                  |詐騙管道以簡訊最多，
                  br
                  |其次是電話與社群媒體
              li.splide__slide(data-aos="fade-up" data-aos-duration="1500")
                img(src="images/icon_intro-3.svg" alt="")
                h3.card-title.noto-900
                  .em.fc-pink-1 27.9%
                  .sub.fc-gray-1 因僥倖心態受騙
                p.card-desc.noto-500.fc-gray-1
                  |因不確定是否為詐騙，
                  br
                  |但選擇冒險
      .section-intro__slogon.fc-gray-1.noto-900(data-aos="fade-right" data-aos-duration="1500")
        span 遇到詐騙，務必斷!捨!釐!
        span.fc-pink-1 快豐鎖
        span !
      .section-intro__hashtag.fc-gray-1.noto-900(data-aos="fade-right" data-aos-duration="1800")
        .hashtag
          span.fc-pink-1 #
          span 警覺詐騙
        .hashtag
          span.fc-pink-1 #
          span 保護自己
        p 遠離詐騙集團魔掌!
      section.center#section-fraud.js-animate.js-animate--fadein-down.js-animate--active
        h2.section-title 勇敢反詐快訊
        h3.section-subtitle.fc-gray-1.noto-900
          span 本行未以「永豐商業金融」帳號名義
          span 邀請客戶申辦信用卡，
          span 請務必留意以免受騙!
    .section-intro__memo.js-animate.js-animate--fadein-down.js-animate--active
      .wrap-memo
        .cut-corner
          .memo-text
            a(href='https://bank.sinopac.com/sinopacBT/about/introduction/announcement/content/20240314160911358000000000000323.html' target='_blank') 本行未以「永豐商業金融」帳號名義邀請客戶申辦信用卡，請務必留意以免受騙！
            a(href='https://bank.sinopac.com/sinopacBT/about/introduction/announcement/content/20240117090850271000000000000845.html' target='_blank') 請注意不肖人士冒用永豐銀行董事名義招攬投資及推廣虛假之「大戶投APP」
            a(href='https://bank.sinopac.com/sinopacBT/about/introduction/announcement/content/20231205165356947000000000000251.html' target='_blank') 請注意不肖人士於網路上提供投資人偽造之永豐銀行「信託證明書」乙事，茲提醒投資人注意
          a.memo-more.noto-900(href='https://bank.sinopac.com/sinopacBT/about/introduction/announcement/content.html' target='_blank') 
            span 更多資訊
            img(src="images/btn-right.svg", alt="")
    
