//- section
mixin section-identify()
  section.section.section-identify#section-identify
    .wrap__inner
      .center.js-animate.js-animate--fadein-down
        h2.section-title.section-title_pc 識別正確網址、
          span 官方
          span.noto-500 APP
          span 及社群帳號
        h2.section-title.section-title_sm 識別正確網址、
          br
          | 官方
          span.noto-500 APP
          span 及社群帳號
      .section-identify_material
        img.section-identify_material-pic(src="images/img_identify-1.svg" alt="識別正確網址與官方APP").js-animate.js-animate--fadein-down.js-animate--delay100
        img.section-identify_material-pic(src="images/img_identify-2.svg" alt="識別正確網址與官方APP").js-animate.js-animate--fadein-up.js-animate--delay500
        .section-identify_material-link
          .section-identify_material-link--title.noto-700.js-animate.js-animate--fadein-down
            img(src="images/img_identify-3.svg" alt="仔細求證官方網址")
            h4 仔細求證官方網址
          .section-identify_material-link--text-1.js-animate.js-animate--fadein-down
            .line.js-animate.js-animate--fadein-down
              p 永豐銀行官網
              a(href='https://bank.sinopac.com/' target='_blank' rel='noopener') https://bank.sinopac.com/
            .line.js-animate.js-animate--fadein-down
              p DAWHO官網
              a(href='https://dawho.tw/' target='_blank' rel='noopener') https://dawho.tw/
            .line.js-animate.js-animate--fadein-down
              p 大咖DACARD官網
              a(href='https://dacard.tw/' target='_blank' rel='noopener') https://dacard.tw/
            .line.js-animate.js-animate--fadein-down
              p 永豐網路銀行(MMA金融交易網)
              a(href='https://mma.sinopac.com/' target='_blank' rel='noopener') https://mma.sinopac.com/
            .line.js-animate.js-animate--fadein-down
              p 永豐WEB ATM
              a(href='https://webatm.sinopac.com/' target='_blank' rel='noopener') https://webatm.sinopac.com/
            .line.js-animate.js-animate--fadein-down
              p 永豐MMA b2c華商個人金融網
              a(href='https://www.mmab2c.com/' target='_blank' rel='noopener') https://www.mmab2c.com/
            .line.js-animate.js-animate--fadein-down
              p 永豐寰宇金融網
              a(href='https://global.sinopac.com/' target='_blank' rel='noopener') https://global.sinopac.com/
            .line.js-animate.js-animate--fadein-down
              p iBranch永豐分行服務網 
              a(href='https://ibranch.sinopac.com/' target='_blank' rel='noopener') https://ibranch.sinopac.com/
          .section-identify_material-link--title.noto-700.padding-1.js-animate.js-animate--fadein-down
            img(src="images/img_identify-3.svg" alt="謹慎識別社群帳號")
            h4 謹慎識別社群帳號
          .section-identify_table.js-animate.js-animate--fadein-down
            .section-identify_table-wrap 
              //- 粉紅色
              .section-identify_table-th.noto-900
                .section-identify_table-th-text 社群類別
                .section-identify_table-th-text 經營帳號
              //- 第一列 LINE
              .section-identify_table-td.table-td-1 
                //- 社群類別內容
                .section-identify_table-td-type.table-td--type.table-td-1-type 
                  img(src="images/img_community-1.svg" alt="")
                  p LINE
                //- 經營帳號內容
                .section-identify_table-td-account.table-td-1-account
                  a.section-identify_table-td-link(href='https://lin.ee/mKcmEJy' target='_blank' rel='noopener')
                    img(src="images/img_community-9.svg" alt="")
                    .line-icon 
                      img(src="images/img_line.svg" alt="")
                      p 永豐銀行
                    p (@banksinopac)
              //- 第二列 FB
              .section-identify_table-td.table-td-2 
                //- 社群類別內容
                .section-identify_table-td-type.table-td-2-type 
                  img(src="images/img_community-2.svg" alt="")
                  p Facebook
                //- 經營帳號內容
                .section-identify_table-td-account.table-td-2-account 
                  a.section-identify_table-td-link(href='https://www.facebook.com/SinoPac' target='_blank' rel='noopener')
                    img(src="images/img_community-9.svg" alt="")
                    p 永豐銀行
                  a.section-identify_table-td-link.dot-img(href='https://www.facebook.com/SinoPacCareers' target='_blank' rel='noopener')
                    img(src="images/img_community-5@3x.png" alt="")
                    p 永豐銀行
                    p SinoPac Careers
                  a.section-identify_table-td-link(href='https://www.facebook.com/BankSinoPacVietnam' target='_blank' rel='noopener')
                    img(src="images/img_community-9.svg" alt="")
                    p Bank SinoPac 
                    p Vietnam 
                  a.section-identify_table-td-link(href='https://www.facebook.com/BSIBsinopac/' target='_blank' rel='noopener')
                    img(src="images/img_community-6.svg" alt="")
                    p DA BOSS
                  a.section-identify_table-td-link.dot-img(href='https://www.facebook.com/NCKUsinopacbk' target='_blank' rel='noopener')
                    img(src="images/img_community-7@3x.png" alt="")
                    p 永豐@成大
              //- 第三列 IG
              .section-identify_table-td.table-td-3 
                //- 社群類別內容
                .section-identify_table-td-type.table-td-3-type 
                  img(src="images/img_community-3.svg" alt="")
                  p Instagram
                //- 經營帳號內容
                .section-identify_table-td-account.table-td-3-account
                  a.section-identify_table-td-link(href='https://instagram.com/dawho.tw?igshid=1rzs2o66tcgvy' target='_blank' rel='noopener')
                    img(src="images/img_community-8.svg" alt="")
                    p DAWHO Chil生活
                    p (dawho.tw)
                  a.section-identify_table-td-link(href='https://www.instagram.com/sinopac.card?igsh=bnNhb21xb3lrNW02' target='_blank' rel='noopener')
                    img(src="images/img_community-9.svg" alt="")
                    p 永豐信用卡|刷卡享優惠
                    p (sinopac.card)
              //- 第四列 YT
              .section-identify_table-td.table-td-4 
                //- 社群類別內容
                .section-identify_table-td-type.table-td-4-type 
                  img(src="images/img_community-4.svg" alt="")
                  p  YouTube
                //- 經營帳號內容
                .section-identify_table-td-account.table-td-4-account
                  a.section-identify_table-td-link(href='https://www.youtube.com/user/mmasinopac' target='_blank' rel='noopener')
                    img(src="images/img_community-9.svg" alt="")
                    p 永豐銀行官方頻道
                    p (@mmasinopac)
          .section-identify_material-link--title.noto-700.padding-2.js-animate.js-animate--fadein-down
            img(src="images/img_identify-3.svg" alt="小心識別APP")
            h4 小心識別APP
          .section-identify_material-link--text-2.js-animate.js-animate--fadein-down
            .line.js-animate.js-animate--fadein-down
              p Google Play下載區
              a(href='https://play.google.com/store/apps/developer?id=Bank+SinoPac&hl=zh_TW' target='_blank' rel='noopener') https://play.google.com/store/apps/developer?id=Bank+SinoPac&hl=zh_TW
            .line.js-animate.js-animate--fadein-down
              p APP Store下載區
              a(href='https://apps.apple.com/tw/developer/banksinopac/id393497159?see-all=i-phone-apps' target='_blank' rel='noopener') https://apps.apple.com/tw/developer/banksinopac/id393497159?see-all=i-phone-apps
          .section-identify_icons.js-animate.js-animate--fadein-down
            img.dot-img(src='images/img_identify-icon-1@3x.png' alt='')(data-aos="fade-up" data-aos-duration="1200")
            img(src='images/img_identify-icon-2.svg' alt='')(data-aos="fade-up" data-aos-duration="1400")
            img(src='images/img_identify-icon-3.svg' alt='')(data-aos="fade-up" data-aos-duration="1600")
            img(src='images/img_identify-icon-4.svg' alt='')(data-aos="fade-up" data-aos-duration="1800")
            img.dot-img(src='images/img_identify-icon-5@3x.png' alt='')(data-aos="fade-up" data-aos-duration="2000")
            
