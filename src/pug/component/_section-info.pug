//- section
mixin section-info()
  section.section.section-info#section-info
    .wrap__inner
      h4.section-info_title.noto-700.js-animate.js-animate--fadein-down.js-animate--active 政府詐騙資訊公告及線上查證
      .section-info_content
        .section-info_content-block.js-animate.js-animate--fadein-down.js-animate--delay100
          p.section-info_content-block--head 涉詐資訊公告
          .section-info_content-block--link
            a(href='https://165.npa.gov.tw/#/lineld' target='_blank' rel='noopener') 詐騙LINE ID
              img(src="images/btn-right.svg", alt="")
            a(href='https://165.npa.gov.tw/#/articles/subclass/4' target='_blank' rel='noopener') 詐騙電話
              img(src="images/btn-right.svg", alt="")
            a(href='https://165.npa.gov.tw/#/articles/subclass/1' target='_blank' rel='noopener') 詐騙境外帳戶
              img(src="images/btn-right.svg", alt="")
            a(href='https://165.npa.gov.tw/#/articles/subclass/3' target='_blank' rel='noopener') 假投資網站
              img(src="images/btn-right.svg", alt="")
            a(href='https://165.npa.gov.tw/#/articles/subclass/5' target='_blank' rel='noopener') 高風險賣場
              img(src="images/btn-right.svg", alt="")

        .section-info_content-block.js-animate.js-animate--fadein-down.js-animate--delay300
          p.section-info_content-block--head 線上查證功能
          .section-info_content-block--link
            a(href='https://165.npa.gov.tw/#/' target='_blank' rel='noopener') 165全民防騙網首頁查詢功能
              img(src="images/btn-right.svg", alt="")
            a(href='https://moneywise.fsc.gov.tw/home.jsp?id=24&parentpath=0&type=2' target='_blank' rel='noopener') 金融智慧網-防詐騙專區
              img(src="images/btn-right.svg", alt="")
            a(href='https://tfc-taiwan.org.tw/topic/8023' target='_blank' rel='noopener') 台灣事實查核中心反詐騙專區
              img(src="images/btn-right.svg", alt="")