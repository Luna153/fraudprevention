//- section
mixin section-help()
  section.section.section-help#section-help
    .center.js-animate.js-animate--fadein-down.js-animate--active
      h2.section-title.section-title_pc 受騙求救
        span.section-title_space 我來幫您 !
      h2.section-title.section-title_sm 受騙求救
        br
        |我來幫您 !
    .section-help_block.js-animate.js-animate--fadein-down.js-animate--active
      .section-help_block-content.js-animate.js-animate--fadein-down
        .section-help_block-content--pic
          img(src="images/icon_help-1.svg" alt="撥打165反詐專線")
        h4.section-help_block-content--title.noto-700 撥打165反詐專線
        p.section-help_block-content--text 告知匯出、匯入帳號、金額、時間及地點
      .section-help_block-content.js-animate.js-animate--fadein-down.js-animate--delay100
        .section-help_block-content--pic
          img(src="images/icon_help-2.svg" alt="撥打110報警")
        h4.section-help_block-content--title.noto-700 撥打110報警
        p.section-help_block-content--text 請警方通知收款銀行，凍結詐騙帳戶，並啟動圈存機制，保住錢財
      .section-help_block-content.js-animate.js-animate--fadein-down.js-animate--delay200
        .section-help_block-content--pic
          img(src="images/icon_help-3.svg" alt="前往警局")
        h4.section-help_block-content--title.noto-700 前往警局
        p.section-help_block-content--text 攜帶轉帳明細與相關資料到警局完成筆錄、保留報案三聯單
      .section-help_block-content.js-animate.js-animate--fadein-down.js-animate--delay300
        .section-help_block-content--pic
          img(src="images/icon_help-4.svg" alt="前往詐騙所屬銀行")
        h4.section-help_block-content--title.noto-700 前往詐騙所屬銀行
        p.section-help_block-content--text 圈存成功並完成筆錄，攜帶報案三聯單、圈存資料，至銀行填資料申請返還
